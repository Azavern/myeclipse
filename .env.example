SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# CRON_SECRET: minimal 32 karakter acak (mis. `openssl rand -hex 32`); sama dengan yang diset di Vercel
CRON_SECRET=
# Hanya untuk skrip lokal npm run bootstrap:admin (jangan diset di Vercel)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Koneksi Postgres untuk `npm run test:db` (pgTAP tanpa Docker).
# Cloud: connection string proyek Supabase. Lokal: postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL=
