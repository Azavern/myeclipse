SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
# CRON_SECRET: minimal 32 karakter acak (mis. `openssl rand -hex 32`); sama dengan yang diset di Vercel.
# Dipakai /api/health dan pemanggilan terjadwal /api/qr/cleanup.
CRON_SECRET=
# SMTP untuk kode OTP perubahan email. Gmail: pakai App Password, bukan kata sandi akun.
# Hanya dibaca di server; tanpa keduanya tombol Verifikasi email akan gagal mengirim kode.
SMTP_EMAIL=
SMTP_PASSWORD=
# Google OAuth tidak memakai variabel di aplikasi: Client ID/Secret diisi di
# Supabase Dashboard → Authentication → Providers → Google. Di Google Cloud
# Console, authorized redirect URI = https://<project-ref>.supabase.co/auth/v1/callback;
# di Supabase, Redirect URLs memuat `${APP_URL}/auth/callback`.

# Hanya untuk skrip lokal npm run bootstrap:admin (jangan diset di Vercel)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Koneksi Postgres untuk `npm run test:db` (pgTAP tanpa Docker).
# Cloud: connection string proyek Supabase. Lokal: postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL=
